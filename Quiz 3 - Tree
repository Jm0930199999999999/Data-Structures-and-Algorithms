int main() {
    int userArray[ARRAY_SIZE];
    int menuChoice;

    cout << "==================================================================\n";
    cout << "  CS 104: TREE ARCHITECTURE SIMULATOR ENGINE \n";
    cout << "==================================================================\n";
    cout << "Please input exactly 10 spatial integer values:\n";
    for (int i = 0; i < ARRAY_SIZE; i++) {
        cout << "Element [" << (i + 1) << "] : ";
        cin >> userArray[i];
    }

    do {
        cout << "\n========================================================\n";
        cout << "         TREE ARCHITECTURE SELECTOR          \n";
        cout << "========================================================\n";
        cout << "1. Run General Tree / N-ary Tree Representation\n";
        cout << "2. Run Standard Binary Tree Representation\n";
        cout << "3. Run Binary Search Tree (BST) Sorting Protocol\n";
        cout << "4. Run Self-Balancing AVL Search Tree Protocol\n";
        cout << "5. Run Complete Binary Tree / Max-Heap Array Map\n";
        cout << "6. Run Full Binary Tree Enforcement Format\n";
        cout << "7. Run Perfect Binary Tree Structural Map\n";
        cout << "8. Run Trie (Prefix Tree) Character Base Digit Parse\n";
        cout << "9. Exit Application\n";
        cout << "========================================================\n";
        cout << "Choose a tree model to construct: ";
        cin >> menuChoice;

        switch (menuChoice) {
            case 1: {
                cout << "\n[Building General N-ary Tree Node Mapping...]\n";
                GeneralNode* gRoot = buildGeneralTree(userArray);
                printGeneralTreeBFS(gRoot);
                freeGeneralTree(gRoot);
                break;
            }
            case 2: {
                cout << "\n[Building Standard Complete Binary Iteration Node Map...]\n";
                BinaryNode* bRoot = buildStandardBinaryTree(userArray, 0, ARRAY_SIZE);
                cout << "Level-Order Traversal View: ";
                printLevelOrder(bRoot);
                freeBinaryTree(bRoot);
                break;
            }
            case 3: {
                cout << "\n[Executing Binary Search Tree Sequential Node Insertions...]\n";
                BinaryNode* bstRoot = nullptr;
                for (int i = 0; i < ARRAY_SIZE; i++) bstRoot = insertBST(bstRoot, userArray[i]);
                cout << "In-Order Sorted Sequence Display : ";
                printInOrder(bstRoot);
                cout << "\nLevel-Order Structure View Representation: ";
                printLevelOrder(bstRoot);
                freeBinaryTree(bstRoot);
                break;
            }
            case 4: {
                cout << "\n[Executing Auto-Balancing AVL Insertion Rotations...]\n";
                BinaryNode* avlRoot = nullptr;
                for (int i = 0; i < ARRAY_SIZE; i++) avlRoot = insertAVL(avlRoot, userArray[i]);
                cout << "In-Order Balanced Dataset Outputs : ";
                printInOrder(avlRoot);
                cout << "\nLevel-Order Balanced Heights Display: ";
                printLevelOrder(avlRoot);
                freeBinaryTree(avlRoot);
                break;
            }
            case 5: {
                cout << "\n[Executing Complete Binary Heapification Matrix Transformations...]\n";
                int heapTemp[ARRAY_SIZE];
                for (int i = 0; i < ARRAY_SIZE; i++) heapTemp[i] = userArray[i];
                // Loop backward from last internal node to structure elements
                for (int i = (ARRAY_SIZE / 2) - 1; i >= 0; i--) heapify(heapTemp, ARRAY_SIZE, i);

                BinaryNode* heapRoot = buildStandardBinaryTree(heapTemp, 0, ARRAY_SIZE);
                cout << "Complete Max-Heap Structure View: ";
                printLevelOrder(heapRoot);
                freeBinaryTree(heapRoot);
                break;
            }
            case 6: {
                cout << "\n[Evaluating Full Binary Array Subset Slices...]\n";
                BinaryNode* fullRoot = buildFullBinaryTree(userArray);
                cout << "Full Binary Tree Layout (Every parent has 0 or 2 children): ";
                printLevelOrder(fullRoot);
                freeBinaryTree(fullRoot);
                break;
            }
            case 7: {
                cout << "\n[Evaluating Perfect Binary Symmetrical Framework Components...]\n";
                BinaryNode* perfRoot = buildPerfectBinaryTree(userArray);
                cout << "Perfect Binary Tree Level View (7 complete node blocks): ";
                printLevelOrder(perfRoot);
                freeBinaryTree(perfRoot);
                break;
            }
            case 8: {
                cout << "\n[Building Key Segment Digital Digit Trie Trees...]\n";
                TrieNode* trieRoot = new TrieNode();
                for (int i = 0; i < ARRAY_SIZE; i++) insertTrie(trieRoot, userArray[i]);
                cout << "Extracted parsed absolute values stored within Trie paths: ";
                printTrieDFS(trieRoot, "");
                cout << "\n";
                freeTrie(trieRoot);
                break;
            }
            case 9:
                cout << "\nShutting down Tree Simulation Console Pipeline. Goodbye!\n";
                break;
            default:
                cout << "\nInvalid choice selection parameter structural range! Try again.\n";
        }
    } while (menuChoice != 9);

    return 0;
}
